<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>KeyboardToolRebinds</AssemblyName>
        <RootNamespace>KeyboardToolRebinds</RootNamespace>
        <Product>KeyboardToolRebinds</Product>
        <BepInExPluginGuid>com.ilgax.keyboardtoolrebinds</BepInExPluginGuid>
        <!-- Single source of truth for the mod version (plugin, Thunderstore, Nexus, git tag). -->
        <Version>2.2.0</Version>
        <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
        <LangVersion>latest</LangVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <!-- Ignore processor architecture mismatch warnings from game assemblies. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
        <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=/</PathMap>

        <!-- Local game install. Override with -p:SilksongDir=... ; ignored in CI. -->
        <SilksongDir Condition="'$(SilksongDir)' == ''">D:\SteamLibrary\steamapps\common\Hollow Knight Silksong</SilksongDir>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Core" Version="5.4.21" />
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
        <PackageReference Include="UnityEngine.Modules" Version="6000.0.50" IncludeAssets="compile" />
        <!-- Stripped game assemblies so the mod builds without the game installed (CI). -->
        <PackageReference Include="Silksong.GameLibs" Version="1.2.0-silksong1.0.30000" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="decompiled/**" />
        <None Remove="decompiled/**" />
    </ItemGroup>

    <!-- Copy the built plugin into the local game after building (skipped in CI or if the game isn't found). -->
    <Target Name="CopyToGame" AfterTargets="Build"
            Condition="'$(CI)' != 'true' And Exists('$(SilksongDir)\BepInEx\plugins')">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SilksongDir)\BepInEx\plugins" ContinueOnError="WarnAndContinue" />
    </Target>
</Project>
